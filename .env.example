# Gestión de Taller Vibacar — configuración
# Copia este archivo como .env y rellena los valores. El .env NO se versiona.

# Puerto del servidor web. Facturación usa el 3000; taller usa el 3010.
# Para un servidor de pruebas de solo lectura: PORT=5055
PORT=3010

# Usuario administrador inicial. Solo se usa la PRIMERA vez que arranca el servidor,
# cuando la tabla de usuarios está vacía: crea ese usuario con rol "admontaller".
# Después, los usuarios se gestionan desde la app (o con scripts/crear-usuario.js).
# Si APP_CLAVE está vacía, no se crea ningún usuario y no se puede entrar.
APP_USUARIO=admin
APP_CLAVE=

# Secreto para firmar la cookie de sesión. Pon una cadena larga y aleatoria.
# Si se cambia, todas las sesiones abiertas caducan.
SECRETO_COOKIE=

# Días que dura una sesión abierta sin volver a pedir contraseña.
SESION_DIAS=30

# Numeración de O.T. (formato AAAA-NNNN). El histórico real está en Karve.
# Hasta que exista la sincronización con Karve (Fase 5), el contador se fija a mano
# con scripts/fijar-contador.js. Este valor solo se usa si el contador del año no existe aún.
# Ejemplo: si la última O.T. de 2026 en Karve es la 2026-0412, pon 412.
CONTADOR_OT_INICIAL=0

# Karve (Fase 5). NO se instala el driver por npm: va en una carpeta local del proyecto.
# KARVE_DRIVER_DIR=driver-karve
# KARVE_CONNECTION_STRING=

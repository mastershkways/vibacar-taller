# Gestión de Taller Vibacar — configuración
# Copia este archivo como .env y rellena los valores. El .env NO se versiona.

# Puerto del servidor web. Facturación usa el 3000; taller usa el 3010.
# Para un servidor de pruebas de solo lectura: PORT=5055
PORT=3010

# Usuario administrador inicial. Solo se usa la PRIMERA vez que arranca el servidor,
# cuando la tabla de usuarios está vacía: crea ese usuario con rol "admontaller".
# Después, los usuarios se gestionan desde la app (o con scripts/crear-usuario.js).
# Si APP_CLAVE está vacía, no se crea ningún usuario y no se puede entrar.
APP_USUARIO=admin
APP_CLAVE=

# Secreto para firmar la cookie de sesión. Pon una cadena larga y aleatoria.
# Si se cambia, todas las sesiones abiertas caducan.
SECRETO_COOKIE=

# Días que dura una sesión abierta sin volver a pedir contraseña.
SESION_DIAS=30

# Numeración de O.T. con el formato de Karve (10 dígitos, p. ej. 0000107951). El servidor lee el máximo de Karve al arrancar
# y antes de cada alta; este valor solo sirve de arranque si no hay conexión. Último número real conocido:
# Hasta que exista la sincronización con Karve (Fase 6), el contador se fija a mano
# con scripts/fijar-contador.js. Este valor solo se usa si el contador del año no existe aún.
# Ejemplo: si la última O.T. de 2026 en Karve es la 2026-0412, pon 412.
CONTADOR_OT_INICIAL=0

# Karve (SAP SQL Anywhere 17), SOLO LECTURA desde la Fase 3.5 (karve.js). El driver ODBC NO se instala por npm:
# va en la carpeta local driver-sql/ (ignorada por git) y el nombre "SQL Anywhere 17" tiene que estar registrado
# en el Administrador ODBC de 64 bits (docs/INSTALACION.md §13). Estas cadenas nunca se pegan en un chat.
# Base de PRUEBAS (la que usa la Fase 3.5); si no trae CharSet=UTF-8, karve.js lo añade:
KARVE_COPIA_CONNECTION_STRING="DRIVER={SQL Anywhere 17};ServerName=nombre_servidor_test;Host=ip_o_host:2638;DatabaseName=nombre_bd_test;UID=usuario;PWD=contraseña;"
# Producción (más adelante, con un usuario de solo lectura):
# KARVE_CONNECTION_STRING=
